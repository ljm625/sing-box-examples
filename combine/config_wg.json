{
    "dns": {
      "disable_cache": false,
      "servers": [
        {
          "address": "tls://1.1.1.1",
          "detour": "direct"
        }
      ]
    },
    "inbounds": [
        {
            "type": "trojan",
            "listen": "::",
            "listen_port": TR_PORT,
            "users": [
                {
                    "password": "TR_PASSWD"
                }
            ],
            "tls": {
                "enabled": true,
                "certificate_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.crt",
                "key_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.key"
            }
        }
    ],
    "log": {
      "level": "info"
    },
    "outbounds": [
      {
        "local_address": [
          "WG_ADDR"
        ],
        "peer_public_key": "WG_PUBLIC",
        "private_key": "WG_PRIVATE",
        "server": "WG_SERVER",
        "server_port": WG_PORT,
        "system_interface": false,
        "tag": "warp",
        "type": "wireguard"
      },
      {
        "tag": "direct",
        "type": "direct"
      },
      {
        "tag": "dns-out",
        "type": "dns"
      },
      {
        "tag": "block",
        "type": "block"
      }
    ],
    "route": {
      "auto_detect_interface": true,
      "final": "warp",
      "rules": [
        {
          "outbound": "dns-out",
          "protocol": "dns"
        },
        {
          "outbound": "block",
          "port": [
            443
          ],
          "protocol": "quic"
        }
      ]
    }
  }
