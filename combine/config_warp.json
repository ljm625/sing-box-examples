{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "direct-dns",
        "server": "1.1.1.1",
        "server_port": 853,
        "detour": "direct"
      },
      {
        "type": "tls",
        "tag": "warp-dns",
        "server": "1.1.1.1",
        "server_port": 853,
        "detour": "warp"
      }
    ],
    "final": "warp-dns",
    "disable_cache": false
  },
  "inbounds": [
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "::",
      "listen_port": __TROJAN_PORT__,
      "users": [
        {
          "name": "default",
          "password": "__TROJAN_PASSWORD__"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/certs/__DOMAIN__.crt",
        "key_path": "/etc/sing-box/certs/__DOMAIN__.key"
      }
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "warp",
      "system": false,
      "mtu": __WARP_MTU__,
      "address": [
        "__WARP_IPV4__",
        "__WARP_IPV6__"
      ],
      "private_key": "__WARP_PRIVATE_KEY__",
      "domain_resolver": "direct-dns",
      "peers": [
        {
          "address": "__WARP_SERVER__",
          "port": __WARP_SERVER_PORT__,
          "public_key": "__WARP_PEER_PUBLIC_KEY__",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "persistent_keepalive_interval": 30,
          "reserved": [
            __WARP_RESERVED_1__,
            __WARP_RESERVED_2__,
            __WARP_RESERVED_3__
          ]
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "port": 443,
        "action": "reject"
      }
    ],
    "final": "warp"
  }
}