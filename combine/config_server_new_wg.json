{
    "dns": {
        "servers": [
        {
            "type": "local",
            "tag": "local"
        }
        ]
    },
    "endpoints": [
        {
        "type": "wireguard",
        "tag": "wg-server",
        "system": false,
        "mtu": 1408,
        "address": ["10.10.0.1/24"],
        "private_key": "WG_PRIVATE_KEY",
        "listen_port": WG_PORT,
        "peers": [
            {
            "public_key": "WG_PUBLIC_KEY",
            "allowed_ips": ["10.10.0.2/32"]
            }
        ]
        }
    ],
    "inbounds": [
        {
            "type": "trojan",
            "listen": "::",
            "listen_port": TR_PORT,
            "users": [
                {
                    "password": "TR_PASSWD"
                }
            ],
            "tls": {
                "enabled": true,
                "certificate_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.crt",
                "key_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.key"
            }
        },
        {
            "type": "vmess",
            "listen": "127.0.0.1",
            "listen_port": 15001,
            "users": [
                {
                    "uuid": "WS_UUID",
                    "alterId": 0
                }
            ],
            "transport": {
                "type": "ws",
                "path": "/WS_PATH",
                "max_early_data": 2048,
                "early_data_header_name": "Sec-WebSocket-Protocol"
            }
        }

    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct",
            "domain_resolver": {
                "server": "local",
                "strategy": "prefer_ipv4"
            }        
        }
    ],
    "route": {
        "rules": [
            {
                "protocol": [
                    "quic"
                ],
                "port": [
                    443
                ],
                "action": "reject"
            },
            {
                "outbound": "direct",
                "network": "udp,tcp"
            }
        ]
    }        
}
