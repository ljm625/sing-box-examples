{
    "dns": {
        "servers": [
        {
            "type": "local",
            "tag": "local"
        }
        ]
    },
    "inbounds": [
        {
            "type": "tuic",
            "listen": "::",
            "listen_port": TUIC_PORT,
            "users": [
                {
                    "name": "louis",
                    "uuid": "WS_UUID",
                    "password": "WS_PATH"
                }
            ],
            "congestion_control": "bbr",
            "auth_timeout": "3s",
            "zero_rtt_handshake": false,
            "heartbeat": "10s",
            "tls": {
                "enabled": true,
                "alpn": [
                    "h3"
                ],
                "certificate_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.crt",
                "key_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.key"
            }
        },
        {
            "type": "trojan",
            "listen": "::",
            "listen_port": TR_PORT,
            "users": [
                {
                    "password": "TR_PASSWD"
                }
            ],
            "tls": {
                "enabled": true,
                "certificate_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.crt",
                "key_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.key"
            }
        },
        {
            "type": "vmess",
            "listen": "127.0.0.1",
            "listen_port": 15001,
            "users": [
                {
                    "uuid": "WS_UUID",
                    "alterId": 0
                }
            ],
            "transport": {
                "type": "ws",
                "path": "/WS_PATH",
                "max_early_data": 2048,
                "early_data_header_name": "Sec-WebSocket-Protocol"
            }
        }

    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct",
            "domain_resolver": {
                "server": "local",
                "strategy": "prefer_ipv4"
            }        
        }
    ],
    "route": {
        "rules": [
            {
                "protocol": [
                    "quic"
                ],
                "port": [
                    443
                ],
                "action": "reject"
            },
            {
                "outbound": "direct",
                "network": "udp,tcp"
            }
        ]
    }        
}
