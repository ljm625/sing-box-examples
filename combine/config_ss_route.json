{
  "dns": {
    "disable_cache": false,
    "servers": [
      {
        "address": "tls://1.1.1.1",
        "detour": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "type": "trojan",
      "listen": "::",
      "listen_port": TR_PORT,
      "users": [
        {
          "password": "TR_PASSWD"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.crt",
        "key_path": "/etc/sing-box/certs/YOUR_DOMAIN_NAME.key"
      }
    }
  ],
  "log": {
    "level": "info"
  },
  "outbounds": [
    {
      "tag":"ss",
      "type": "shadowsocks",
      "server": "SS_SERVER",
      "server_port": SS_PORT,
      "method": "2022-blake3-aes-128-gcm",
      "password": "SS_PASSWD"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "ss",
    "rules": [
      {
        "action": "reject",
        "port": [
          443
        ],
        "protocol": "quic"
      }
    ]
  }
}